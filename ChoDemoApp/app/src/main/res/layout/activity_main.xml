<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色糖果主题 + 左下角添加日程浮动按钮 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/example_5_page_bg_color"
	android:clickable="true"
	android:focusable="true"
	tools:context=".MainActivity">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appBarLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/example_5_toolbar_color"
		android:theme="@style/ThemeOverlay.MaterialComponents.Light">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="14dp">

			<ImageView
				android:id="@+id/prevMonthImage"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginEnd="22dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				app:tint="@android:color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_chevron_left" />

			<TextView
				android:id="@+id/monthTitleText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-medium"
				android:textColor="@android:color/white"
				android:textSize="22sp"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@id/nextMonthImage"
				app:layout_constraintStart_toEndOf="@id/prevMonthImage"
				app:layout_constraintTop_toTopOf="parent"
				tools:text="April 2018" />

			<ImageView
				android:id="@+id/adminButton"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginEnd="4dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="管理员"
				android:visibility="gone"
				app:tint="#FFD700"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@id/searchButton"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_tab_memo" />

			<ImageView
				android:id="@+id/searchButton"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginEnd="4dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="搜索"
				app:tint="@android:color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@id/loginStatusImage"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_add" />

			<ImageView
				android:id="@+id/loginStatusImage"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginEnd="4dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="登录状态"
				app:tint="@android:color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@id/nextMonthImage"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_tab_assistant" />

			<ImageView
				android:id="@+id/nextMonthImage"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				app:tint="@android:color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_chevron_right" />

		</androidx.constraintlayout.widget.ConstraintLayout>

	</com.google.android.material.appbar.AppBarLayout>

	<LinearLayout
		android:id="@+id/contentLayout"
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">

		<!-- Tab1: 日程日历 -->
		<LinearLayout
			android:id="@+id/calendarTab"
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingStart="8dp"
			android:paddingEnd="8dp">

			<com.kizitonwose.calendar.view.CalendarView
				android:id="@+id/calendarView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cv_dayViewResource="@layout/item_calendar_day"
				app:cv_monthHeaderResource="@layout/item_calendar_header"
				app:cv_outDateStyle="endOfGrid" />

			<TextView
				android:id="@+id/selectedDateText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="8dp"
				android:paddingBottom="4dp"
				android:textSize="16sp"
				android:textColor="@color/example_5_text_grey"
				android:text="今天暫無日程" />

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/eventsRecyclerView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:nestedScrollingEnabled="false" />
		</LinearLayout>

		<!-- Tab2: 问答助手（万机 Agent V2） -->
		<LinearLayout
			android:id="@+id/assistantTab"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:paddingTop="12dp"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<TextView
					android:id="@+id/assistantTitle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="日程问答助手"
					android:textColor="@color/example_5_text_grey"
					android:textSize="18sp"
					android:textStyle="bold" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/clearConversationButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="清空"
					android:textSize="12sp"
					android:textColor="@android:color/white"
					app:backgroundTint="@color/example_1_selection_color" />
			</LinearLayout>

			<TextView
				android:id="@+id/assistantSubtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="可以围绕个人日程进行自然语言问答，支持创建、查询、修改日程和备忘录。"
				android:textColor="@color/example_5_text_grey_light"
				android:textSize="13sp" />

			<!-- 对话列表 - 占据中间主要区域 -->
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/conversationRecyclerView"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:layout_marginTop="8dp"
				android:clipToPadding="false" />

			<!-- 建议确认按钮区域（默认隐藏）- 位于输入框上方 -->
			<LinearLayout
				android:id="@+id/suggestionLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				android:background="@drawable/bg_time_chip"
				android:padding="12dp"
				android:layout_marginBottom="8dp">

				<TextView
					android:id="@+id/suggestionText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="检测到时间建议"
					android:textColor="@color/example_5_text_grey"
					android:textSize="14sp" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:layout_marginTop="8dp">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/acceptSuggestionButton"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginEnd="8dp"
						android:text="使用建议时间"
						android:textSize="12sp"
						android:textColor="@android:color/white"
						app:backgroundTint="@color/example_1_selection_color" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/rejectSuggestionButton"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="重新输入"
						android:textSize="12sp"
						style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
				</LinearLayout>
			</LinearLayout>

			<!-- 输入框 - 固定在底部 -->
			<LinearLayout
				android:id="@+id/assistantInputLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:paddingBottom="8dp">

				<EditText
					android:id="@+id/assistantInput"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:hint="例如：帮我安排明天下午3点的会议" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/assistantSendButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="发送"
					android:textColor="@android:color/white"
					app:backgroundTint="@color/example_1_selection_color" />
			</LinearLayout>
		</LinearLayout>

		<!-- Tab3: 备忘录 -->
		<LinearLayout
			android:id="@+id/memoTab"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:paddingTop="12dp"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<TextView
					android:id="@+id/memoTitle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="备忘录"
					android:textColor="@color/example_5_text_grey"
					android:textSize="18sp"
					android:textStyle="bold" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/memoScanButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="10dp"
					android:text="拍照"
					android:textColor="@android:color/white"
					app:backgroundTint="@color/example_1_selection_color" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/addMemoButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="新增"
					android:textColor="@android:color/white"
					app:backgroundTint="@color/example_1_selection_color" />
			</LinearLayout>

			<TextView
				android:id="@+id/memoEmptyText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="还没有任何备忘哦，点击右侧“新增”开始记录。"
				android:textColor="@color/example_5_text_grey_light"
				android:textSize="13sp" />

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/memoRecyclerView"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:layout_marginTop="4dp" />
		</LinearLayout>

		<!-- Tab4: Lynx 页面容器 -->
		<LinearLayout
			android:id="@+id/lynxTab"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical"
			android:visibility="gone">

			<FrameLayout
				android:id="@+id/lynxContainer"
				android:layout_width="match_parent"
				android:layout_height="match_parent" />
		</LinearLayout>
	</LinearLayout>

	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/addEventFab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:contentDescription="添加日程"
		app:layout_anchor="@id/bottomNav"
		app:layout_anchorGravity="top|start"
		app:backgroundTint="@color/example_1_selection_color"
		app:tint="@android:color/white"
		app:srcCompat="@drawable/ic_add" />

	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/locationFab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:contentDescription="定位生成日程"
		app:layout_anchor="@id/bottomNav"
		app:layout_anchorGravity="top|end"
		app:backgroundTint="@color/example_1_selection_color"
		app:tint="@android:color/white"
		app:srcCompat="@drawable/ic_airplane_landing" />

	<com.google.android.material.bottomnavigation.BottomNavigationView
		android:id="@+id/bottomNav"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@color/example_5_item_view_bg_color"
		app:itemIconTint="@color/bottom_nav_item"
		app:itemTextColor="@color/bottom_nav_item"
		app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
